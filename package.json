{
  "name": "larecode",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "test:tmux": "LARECODE_TMUX=1 vitest run scripts/tmux.test.ts",
    "test:security": "vitest run packages/core/src/permission packages/core/src/exec/backend.test.ts packages/core/src/mcp packages/core/src/context/instructions.test.ts packages/core/src/skill packages/core/src/tool/files.test.ts packages/server/src/server.test.ts packages/gateway/src/telegram.test.ts packages/cli/src/cron.test.ts packages/cli/src/verify.test.ts packages/cli/src/install.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun build --compile --outfile=dist/larecode packages/cli/src/index.ts",
    "build:npm": "bun build --target=node --external @ast-grep/napi --outfile npm/dist/index.js packages/cli/src/index.ts",
    "dev": "bun run packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "2.1.9",
    "oxlint": "^0.15.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "2.1.9"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.3.9"
}
