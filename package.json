{
  "name": "larecode",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "test:tmux": "LARECODE_TMUX=1 vitest run scripts/tmux.test.ts",
    "test:lsp": "LARECODE_LSP_SMOKE=1 vitest run packages/core/src/lsp/lsp.test.ts",
    "test:perf": "vitest run scripts/perf.test.ts",
    "bench": "bun scripts/bench.ts",
    "test:live": "vitest run scripts/live-smoke.test.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "test:security": "vitest run packages/core/src/permission packages/core/src/exec/backend.test.ts packages/core/src/mcp packages/core/src/context/instructions.test.ts packages/core/src/skill packages/core/src/tool/files.test.ts packages/server/src/server.test.ts packages/gateway/src/telegram.test.ts packages/cli/src/cron.test.ts packages/cli/src/verify.test.ts packages/cli/src/install.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun build --compile --outfile=dist/larecode packages/cli/src/index.ts",
    "build:npm": "bun build --target=node --external @ast-grep/napi --outfile npm/dist/index.js packages/cli/src/index.ts",
    "dev": "bun run packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "^0.15.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.3.9",
  "resolutions": {
    "body-parser": "^2.4.0"
  },
  "bun": {
    "audit": {
      "ignore": [
        "GHSA-75px-5xx7-5xc7",
        "GHSA-jvwf-75h9-cwgg",
        "GHSA-685m-2w69-288q",
        "GHSA-xq3m-2v4x-88gg",
        "GHSA-wcpc-wj8m-hjx6",
        "GHSA-f88m-g3jw-g9cj",
        "GHSA-rgj7-g3m4-5g8c",
        "GHSA-wq5f-xc86-pv8c",
        "GHSA-66ff-xgx4-vchm",
        "GHSA-2pr8-phx7-x9h3",
        "GHSA-fx83-v9x8-x52w",
        "GHSA-q6x5-8v7m-xcrf",
        "GHSA-jggg-4jg4-v7c6",
        "GHSA-f38q-mgvj-vph7",
        "GHSA-g89c-p67h-r497",
        "GHSA-2jg2-4ch7-h545",
        "GHSA-wq5f-xc86-pv6w",
        "CVE-2026-33327",
        "CVE-2026-33328",
        "CVE-2026-35590",
        "CVE-2026-35591",
        "CVE-2026-96889"
      ]
    }
  }
}
