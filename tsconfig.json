{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@larecode/core": ["packages/core/src"],
      "@larecode/tui": ["packages/tui/src"],
      "@larecode/cli": ["packages/cli/src"],
      "@larecode/server": ["packages/server/src"],
      "@larecode/gateway": ["packages/gateway/src"],
      "@larecode/sdk": ["packages/sdk/src"],
      "@larecode/skills": ["packages/skills/src"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist/**"]
}
